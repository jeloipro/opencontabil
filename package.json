{
  "name": "azienda-contabil",
  "version": "1.0.0",
  "description": "Sistema Contábil Open Source moderno com SPED ECD, Balanço Patrimonial, DRE, Conciliação OFX e Reforma Tributária",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm --prefix frontend run build",
    "start": "tsx server/index.ts",
    "dev": "tsx server/index.ts",
    "dev:front": "cd frontend && npm run dev"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
